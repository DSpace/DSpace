<?xml version="1.0" encoding="UTF-8"?>
<beans xmlns="http://www.springframework.org/schema/beans"
	   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	   xsi:schemaLocation="http://www.springframework.org/schema/beans http://www.springframework.org/schema/beans/spring-beans.xsd">

    <bean class="org.dspace.content.converter.ItemToItemDTOConverter" />
    <bean class="org.dspace.app.bulkimport.service.BulkImportWorkbookBuilderImpl" />

    <bean class="org.dspace.content.integration.crosswalks.StreamDisseminationCrosswalkMapper">
        <constructor-arg>
            <map>
                <entry key="person-xml" value-ref="referCrosswalkPersonXml"/>
                <entry key="endnote" value-ref="referCrosswalkEndnote"/>
                <entry key="bibtex" value-ref="cslItemDataCrosswalkBibtex"/>
                <entry key="publication-json" value-ref="cslItemDataCrosswalkJson"/>
                <entry key="publication-apa" value-ref="cslItemDataCrosswalkApa"/>
                <entry key="publication-chicago" value-ref="cslItemDataCrosswalkChicago"/>
                <entry key="person-cerif-xml" value-ref="referCrosswalkPersonCerifXml"/>
                <entry key="person-json" value-ref="referCrosswalkPersonJson"/>
                <entry key="publication-cerif-xml" value-ref="referCrosswalkPublicationCerifXml"/>
                <entry key="project-cerif-xml" value-ref="referCrosswalkProjectCerifXml"/>
                <entry key="project-json" value-ref="referCrosswalkProjectJson"/>
                <entry key="orgUnit-cerif-xml" value-ref="referCrosswalkOrgUnitCerifXml"/>
                <entry key="orgUnit-json" value-ref="referCrosswalkOrgUnitJson"/>
                <entry key="funding-cerif-xml" value-ref="referCrosswalkFundingCerifXml"/>
                <entry key="funding-json" value-ref="referCrosswalkFundingJson"/>
                <entry key="publication-csv" value-ref="csvCrosswalkPublication"/>
                <entry key="publication-xls" value-ref="xlsCrosswalkPublication"/>
                <entry key="person-csv" value-ref="csvCrosswalkPerson"/>
                <entry key="person-xls" value-ref="xlsCrosswalkPerson"/>
                <entry key="journal-csv" value-ref="csvCrosswalkJournal"/>
                <entry key="journal-xls" value-ref="xlsCrosswalkJournal"/>
                <entry key="project-csv" value-ref="csvCrosswalkProject"/>
                <entry key="project-xls" value-ref="xlsCrosswalkProject"/>
                <entry key="orgUnit-csv" value-ref="csvCrosswalkOrgUnit"/>
                <entry key="orgUnit-xls" value-ref="xlsCrosswalkOrgUnit"/>
                <entry key="orgUnit-xml" value-ref="referCrosswalkOrgUnitXml"/>
                <entry key="funding-csv" value-ref="csvCrosswalkFunding"/>
                <entry key="funding-xls" value-ref="xlsCrosswalkFunding"/>
                <entry key="person-pdf" value-ref="pdfCrosswalkPerson"/>
                <entry key="person-cv-pdf" value-ref="pdfCrosswalkPersonCv"/>
                <entry key="person-rtf" value-ref="rtfCrosswalkPerson"/>
                <entry key="publication-pdf" value-ref="pdfCrosswalkPublication"/>
                <entry key="project-pdf" value-ref="pdfCrosswalkProject"/>
                <entry key="orgUnit-pdf" value-ref="pdfCrosswalkOrgUnit"/>
                <entry key="funding-pdf" value-ref="pdfCrosswalkFunding"/>
                <entry key="publication-datacite-xml" value-ref="referCrosswalkPublicationDataciteXml"/>
                <entry key="collection-xls" value-ref="xlsCrosswalkCollection"/>
                <entry key="item-zip" value-ref="zipCrosswalk"/>
            </map>
        </constructor-arg>
    </bean>

    <bean class="org.dspace.content.integration.crosswalks.service.ItemExportFormatServiceImpl" />

	<!-- VIRTUAL FIELDS CONFIGURATION -->

    <bean id="virtualFieldsMap" class="java.util.HashMap">
        <constructor-arg>
            <map>
                <entry key="id" value-ref="virtualFieldId" />
                <entry key="authority" value-ref="virtualFieldAuthority" />
                <entry key="primary-doi" value-ref="virtualFieldPrimaryDOI" />
                <entry key="alternative-doi" value-ref="virtualFieldAlternativeDOI" />
                <entry key="reftype" value-ref="virtualFieldRefererType" />
                <entry key="authors" value-ref="virtualFieldAuthors" />
                <entry key="fullpage" value-ref="virtualFieldPageNumber" />
                <entry key="bitstream" value-ref="virtualFieldBitstream" />
                <entry key="mapConverter" value-ref="virtualFieldMapConverter" />
                <entry key="personName" value-ref="virtualFieldPersonName" />
                <entry key="date" value-ref="virtualFieldDateFormatter" />
                <entry key="vocabulary" value-ref="virtualFieldVocabulary" />
                <entry key="vocabulary_i18n" value-ref="virtualFieldVocabularyI18n" />
                <entry key="metric" value-ref="virtualFieldMetric" />
                <entry key="citations" value-ref="virtualFieldCitations" />
                <entry key="place" value-ref="virtualFieldAtPlace" />
            </map>
        </constructor-arg>
    </bean>

    <bean id="virtualFieldMapper"
          class="org.dspace.content.integration.crosswalks.virtualfields.VirtualFieldMapper" lazy-init="true">
		<constructor-arg ref="virtualFieldsMap"/>
	</bean>

    <bean class="org.dspace.content.integration.crosswalks.virtualfields.VirtualFieldToEnhancedMetadata"
        id="virtualFieldToEnhancedMetadata" />
	<bean class="org.dspace.content.integration.crosswalks.virtualfields.VirtualFieldId" id="virtualFieldId"/>
	<bean class="org.dspace.content.integration.crosswalks.virtualfields.VirtualFieldAuthority" id="virtualFieldAuthority"/>
	<bean class="org.dspace.content.integration.crosswalks.virtualfields.ItemDOIService"/>
	<bean class="org.dspace.content.integration.crosswalks.virtualfields.VirtualFieldPrimaryDOI" id="virtualFieldPrimaryDOI"/>
	<bean class="org.dspace.content.integration.crosswalks.virtualfields.VirtualFieldAlternativeDOI" id="virtualFieldAlternativeDOI"/>
	<bean class="org.dspace.content.integration.crosswalks.virtualfields.VirtualFieldRefererType" id="virtualFieldRefererType"/>
	<bean class="org.dspace.content.integration.crosswalks.virtualfields.VirtualFieldAuthors" id="virtualFieldAuthors"/>
	<bean class="org.dspace.content.integration.crosswalks.virtualfields.VirtualFieldPageNumber" id="virtualFieldPageNumber"/>	
	<bean class="org.dspace.content.integration.crosswalks.virtualfields.VirtualFieldPersonName" id="virtualFieldPersonName"/>
	<bean class="org.dspace.content.integration.crosswalks.virtualfields.VirtualFieldBitstream" id="virtualFieldBitstream">
		<constructor-arg name="bitstreamTypeMap">
			<map>
				<entry key="picture" value="personal picture" />
			</map>
		</constructor-arg>
		<constructor-arg name="bitstreamMIMETypeMap">
			<map>
				<entry key="image">
					<set>
						<value>image/jpeg</value>
						<value>image/png</value>
						<value>image/gif</value>
					</set>
				</entry>
				<entry key="pdf">
					<set>
						<value>application/pdf</value>
						<value>application/x-pdf</value>
					</set>
				</entry>
				<entry key="txt">
					<set>
						<value>text/plain</value>
					</set>
				</entry>
			</map>
		</constructor-arg>
	</bean>
	<bean class="org.dspace.content.integration.crosswalks.virtualfields.VirtualFieldMapConverter" id="virtualFieldMapConverter">
		<constructor-arg name="itemService" ref="org.dspace.content.ItemServiceImpl"/>
		<constructor-arg name="mapConverters" ref="org.dspace.util.MapConverters"/>
	</bean>
	<bean class="org.dspace.content.integration.crosswalks.virtualfields.VirtualFieldDateFormatter" id="virtualFieldDateFormatter"/>
	<bean class="org.dspace.content.integration.crosswalks.virtualfields.VirtualFieldVocabulary" id="virtualFieldVocabulary"/>
    <bean class="org.dspace.content.integration.crosswalks.virtualfields.VirtualFieldMetric" id="virtualFieldMetric"/>
    <bean class="org.dspace.content.integration.crosswalks.virtualfields.VirtualFieldCitations" id="virtualFieldCitations"/>
    <bean class="org.dspace.content.integration.crosswalks.virtualfields.VirtualFieldVocabularyI18nValuePair" id="virtualFieldVocabularyI18n"/>
    
    <bean class="org.dspace.content.integration.crosswalks.virtualfields.postprocessors.FirstSelectedCitationsPostProcessor" />
    <bean class="org.dspace.content.integration.crosswalks.virtualfields.postprocessors.GroupByTypeCitationsPostProcessor" />
	<bean class="org.dspace.content.integration.crosswalks.virtualfields.VirtualFieldAtPlace" id="virtualFieldAtPlace"/>

	<!-- CSL citation generators (used by VirtualFieldCitations) -->
	<bean class="org.dspace.content.integration.crosswalks.csl.CSLGeneratorFactory" />
	<bean class="org.dspace.content.integration.crosswalks.csl.CSLNestedGenerator" />
	<bean class="org.dspace.content.integration.crosswalks.csl.CSLWebServiceGenerator" />

	<!-- MapConverter configuration -->

	<bean id="org.dspace.util.MapConverters"  class="org.dspace.util.MapConverters"> 
		<constructor-arg name="mapConverters">
			<map>
				<entry key="coarTypes" value-ref="mapConverterCoarTypes" />
				<entry key="fundingTypes" value-ref="mapConverterFundingTypes" />
				<entry key="eventTypes" value-ref="mapConverterEventTypes" />
				<entry key="orgUnitTypes" value-ref="mapConverterOrgUnitTypes" />
				<entry key="accessRight" value-ref="mapConverterAccessRight" />
				<entry key="coarToPublicationTypes" value-ref="mapConverterCoarToPublicationTypes" />
				<entry key="scopusToCoarPublicationTypes" value-ref="mapConverterScopusToCoarPublicationTypes" />
				<entry key="rorToOrgunitTypes" value-ref="mapConverterRorToOrgunitTypes" />
				<entry key="pubmedToCoarPublicationTypes" value-ref="mapConverterPubmedToCoarPublicationTypes" />
				<entry key="cerifToOrgUnitTypes" value-ref="mapConverterCerifToOrgUnitTypes" />
				<entry key="cerifToFundingTypes" value-ref="mapConverterCerifToFundingTypes" />
                <entry key="type2datacite" value-ref="mapConverterDataciteToPublicationTypes" />
				<entry key="type2datacitelabel" value-ref="mapConverterDataciteToPublicationLabelTypes" />
                <entry key="right2licenseUrl" value-ref="mapConverterDataciteToPublicationLicense" />
                <entry key="right2conceptUrl" value-ref="mapConverterDataciteToPublicationAccessRights" />
			</map>
		</constructor-arg>
	</bean>
	
	<bean name="mapConverterCoarTypes" class="org.dspace.util.SimpleMapConverter" init-method="init">
		<property name="converterNameFile" value="mapConverter-coarTypes.properties" />
		<property name="configurationService" ref="org.dspace.services.ConfigurationService" />
		<property name="defaultValue" value="http://purl.org/coar/resource_type/c_1843"/>
	</bean>
	
	<bean name="mapConverterFundingTypes" class="org.dspace.util.SimpleMapConverter" init-method="init">
		<property name="converterNameFile" value="mapConverter-fundingTypes.properties" />
		<property name="configurationService" ref="org.dspace.services.ConfigurationService" />
		<property name="defaultValue" value="https://www.openaire.eu/cerif-profile/vocab/OpenAIRE_Funding_Types"/>
