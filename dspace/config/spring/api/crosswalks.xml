    <bean name="mapConverterDataciteToPublicationTypes" class="org.dspace.util.SimpleMapConverter" init-method="init">
        <property name="converterNameFile" value="mapConverter-datacitePublicationTypes.properties" />
        <property name="configurationService" ref="org.dspace.services.ConfigurationService" />
        <property name="defaultValue" value="Text"/>
