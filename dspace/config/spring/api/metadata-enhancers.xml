<beans xmlns="http://www.springframework.org/schema/beans"
       xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       xmlns:context="http://www.springframework.org/schema/context"
       xsi:schemaLocation="http://www.springframework.org/schema/beans
           http://www.springframework.org/schema/beans/spring-beans-2.5.xsd
           http://www.springframework.org/schema/context
           http://www.springframework.org/schema/context/spring-context-2.5.xsd"
>

    <context:annotation-config />

    <!-- Core service that orchestrates all item enhancement operations.
         Manages enhancement execution, deep mode processing, and affected item tracking. -->
    <bean id="org.dspace.content.enhancer.service.ItemEnhancerService"
        class="org.dspace.content.enhancer.service.impl.ItemEnhancerServiceImpl" />

    <!-- Enhancer that derives the additional metadata declared by the relationship configuration.
         Which values are derived, and from which source field of the related entity, is defined by
         the metadata generators referenced from relationship-configuration.xml. -->
    <bean class="org.dspace.content.enhancer.impl.RelatedEntityItemEnhancer" />

</beans>
